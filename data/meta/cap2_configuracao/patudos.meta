A página “Os Nossos Patudos” funciona como a montra principal dos verdadeiros protagonistas do “Neko Café”: os gatos residentes. Sob o mote “Sempre carinhosos, curiosos & cheios de energia”, esta secção foi desenvolvida com o objetivo de criar uma ligação emocional imediata com o utilizador, apresentando cada animal de forma individualizada e cativante.";}s:8:"relation";a:2:{s:5:"media";a:5:{s:31:"cap2_configuracao:picture17.png";b:1;s:31:"cap2_configuracao:picture16.png";b:1;s:31:"cap2_configuracao:picture18.png";b:1;s:31:"cap2_configuracao:picture19.png";b:1;s:31:"cap2_configuracao:picture20.png";b:1;}s:10:"firstimage";s:31:"cap2_configuracao:picture17.png";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1780406870;s:8:"modified";i:1780409324;}s:7:"creator";s:8:"SaraReis";s:4:"user";s:4:"sara";s:11:"last_change";a:9:{s:4:"date";i:1780409324;s:2:"ip";s:3:"::1";s:4:"type";s:1:"E";s:2:"id";s:25:"cap2_configuracao:patudos";s:4:"user";s:4:"sara";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:-182;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:4:"sara";s:8:"SaraReis";}}}