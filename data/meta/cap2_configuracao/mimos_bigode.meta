A página “Mimos do Bigode” foi criada para dar destaque às especialidades gastronómicas e produtos exclusivos do “Neko Café”. Com o selo de qualidade “Sempre frescos”, esta secção funciona como uma extensão sensorial do espaço físico, projetada para despertar o interesse de consumo do utilizador através de uma apresentação visual altamente apetecível e organizada.";}s:8:"relation";a:2:{s:5:"media";a:3:{s:31:"cap2_configuracao:picture36.png";b:1;s:31:"cap2_configuracao:picture37.png";b:1;s:31:"cap2_configuracao:picture38.png";b:1;}s:10:"firstimage";s:31:"cap2_configuracao:picture36.png";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1780411655;}s:7:"creator";s:8:"SaraReis";s:4:"user";s:4:"sara";s:11:"last_change";a:9:{s:4:"date";i:1780411655;s:2:"ip";s:3:"::1";s:4:"type";s:1:"C";s:2:"id";s:30:"cap2_configuracao:mimos_bigode";s:4:"user";s:4:"sara";s:3:"sum";s:7:"created";s:5:"extra";s:0:"";s:10:"sizechange";i:1600;s:4:"mode";s:4:"page";}}}