O encerramento deste projeto de Desenvolvimento e Gestão de Conteúdos Web representa a consolidação de todo o trabalho prático e analítico realizado em torno do website temático do Café com Gatos (“Neko Café”). Esta secção final serve para avaliar os resultados obtidos, refletir sobre as ferramentas utilizadas e apresentar as considerações finais da equipa.";}s:8:"relation";a:2:{s:10:"references";a:2:{s:41:"cap5_conclusao:publicacao_e_teste_do_site";b:1;s:45:"cap5_conclusao:curiosidades_sobre_o_wordpress";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1780589878;s:8:"modified";i:1780591823;}s:7:"creator";s:14:"MiguelOliveira";s:4:"user";s:6:"miguel";s:11:"last_change";a:9:{s:4:"date";i:1780591823;s:2:"ip";s:13:"100.73.216.26";s:4:"type";s:1:"E";s:2:"id";s:14:"cap5_conclusao";s:4:"user";s:6:"miguel";s:3:"sum";s:16:"[5. CONCLUSÃO] ";s:5:"extra";s:0:"";s:10:"sizechange";i:4;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:6:"miguel";s:14:"MiguelOliveira";}}}